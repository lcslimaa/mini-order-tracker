# Configuração local lida automaticamente pelo Spring Boot.
# Formato Java properties: sem export e sem aspas nos valores.
# Gere JWT_SECRET com: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_SECONDS=3600

# Defina os três campos para provisionar o operador inicial.
OPERATOR_NAME=Operador
OPERATOR_EMAIL=operador@example.com
OPERATOR_PASSWORD=

DATABASE_URL=jdbc:h2:file:./data/tracker
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
SERVER_PORT=8080
